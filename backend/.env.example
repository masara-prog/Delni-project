# Delni Platform - Backend Configuration
# ====================================

# MySQL Database Configuration
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=delni_db

# Google Gemini API Key for "ذكاء دلّني" (Delni AI Assistant)
