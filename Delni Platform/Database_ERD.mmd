    tourists {
        varchar tourist_id PK
        nvarchar full_name
        nvarchar email
        nvarchar phone_number
        nvarchar password
        nvarchar account_status
        datetime created_at
    }

    private_trips {
        varchar private_trip_id PK
        varchar tourist_id FK
        nvarchar status_order
        date preferred_start_date
        int duration_days
        int number_of_companions
        decimal quoted_price
        varchar vehicle_plate FK
        nvarchar guide_license_number FK
        nvarchar customer_requirements
        datetime created_at
    }

    private_trip_stations {
        varchar station_id PK
        varchar private_trip_id FK
        int day_number
        int station_order
        nvarchar station_title
        varchar station_time
        nvarchar station_desc
    }

    hotels_trip_private {
        varchar private_trip_id PK,FK
        varchar hotel_id PK,FK
    }

    places_trip_private {
        varchar private_trip_id PK,FK
        varchar place_id PK,FK
        int visit_order
    }

    vehicles {
        varchar plate_number PK
        varchar company_contract_number FK
        nvarchar vehicle_type
        int passenger_capacity
        nvarchar vehicle_condition
        nvarchar operational_status
        varchar inspection_date
    }

    drivers {
        varchar driver_license_number PK
        varchar company_contract_number FK
        varchar assigned_vehicle_plate FK
        nvarchar full_name
        nvarchar phone_number
        nvarchar driver_status
    }

    tour_guides {
        nvarchar license_number PK
        nvarchar full_name
        nvarchar phone_number
        nvarchar guide_status
        nvarchar bio
    }

    daily_trips {
        varchar daily_trip_id PK
        nvarchar trip_title
        nvarchar departure_city
        decimal price_per_person
        int max_capacity
        varchar vehicle_plate FK
        nvarchar guide_license_number FK
        varchar trip_status
    }

    weekly_trips {
        varchar weekly_trip_id PK
        nvarchar trip_title
        nvarchar departure_city
        date start_date
        date departure_date
        decimal price_per_person
        int max_capacity
        varchar vehicle_plate FK
        nvarchar guide_license_number FK
        varchar trip_status
    }

    places_tourist {
        varchar place_id PK
        nvarchar place_name
        nvarchar description
        nvarchar city
        nvarchar region
        nvarchar category
        float latitude
        float longitude
    }

    hotels {
        varchar hotel_id PK
        nvarchar hotel_name
        nvarchar city
        nvarchar phone_number
        int star_rating
        nvarchar partnership_status
    }

    restaurants_cafes {
        varchar facility_id PK
        nvarchar facility_name
        nvarchar facility_type
        nvarchar city
        nvarchar phone_number
        nvarchar partnership_status
    }

    notifications {
        varchar id PK
        nvarchar type
        nvarchar title
        nvarchar body
        nvarchar recipient_role
        nvarchar recipient_id
        bit is_read
        varchar dedupe_key
        datetime created_at
    }
