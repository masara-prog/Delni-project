@echo off
chcp 65001 > nul
echo ========================================================
echo        تشغيل منصة دِلني (الواجهة + خادم الباك إند)
echo ========================================================
echo.

echo [1/2] جاري تشغيل خادم الباك إند (Laravel Backend)...
start "Delni Backend API" cmd /k "cd /d "%~dp0..\delni-backend" && php artisan serve --port=8000"

echo [2/2] جاري تشغيل الواجهة (Frontend)...
start "Delni Frontend" cmd /k "cd /d "%~dp0" && npm run dev"

echo.
echo ========================================================
echo  تم تشغيل الخوادم بنجاح!
echo  - الباك إند يعمل على: http://127.0.0.1:8000
echo  - مستعرض الجداول:    http://127.0.0.1:8000/db-viewer
echo ========================================================
echo لا تقم بإغلاق النوافذ السوداء طالما أنك تستخدم المنصة.
pause
